# Resend (https://resend.com) API key used by api/contact.js to send enquiry emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Mailbox that receives contact-form submissions.
CONTACT_RECIPIENT=boilertechniques@gmail.com

# "From" address for outgoing mail. Must be on a domain verified in Resend.
# Until you verify boilertechniques.co.ke (or similar) in Resend, leave this as the
# Resend sandbox sender below — it works immediately but can only deliver to the
# email address on your Resend account.
CONTACT_FROM=PowerPulse Website <onboarding@resend.dev>

# Your production URL, used to validate that contact-form POSTs originate from your
# own site (defense-in-depth against cross-site form submission / spam).
SITE_URL=https://your-deployment.vercel.app
